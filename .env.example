# ==============================================================================
# BENAVERA — Variáveis de Ambiente de Produção & Desenvolvimento
# ==============================================================================

# 1. URL Canônica Principal do Site (sempre com www)
NEXT_PUBLIC_SITE_URL=https://www.benavera.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5547992080926

# 2. Endpoint de Submissão de Leads
NEXT_PUBLIC_BENAVERA_LEAD_ENDPOINT=/api/leads

# 3. Google Search Console (Código de Verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 4. Microsoft Clarity (Analytics e Gravação de Sessões com Mascaramento)
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
NEXT_PUBLIC_CLARITY_DEV=false

# 5. Segurança do Painel Administrativo (/admin)
ADMIN_PASSWORD=sua-senha-admin-segura-aqui
ADMIN_SECRET=seu-segredo-de-sessao-aqui

# 6. Banco de Dados Gerenciado — TURSO (libSQL / SQLite na Nuvem) [RECOMENDADO]
# Crie seu banco no Turso (turso db create benavera-db) e insira a URL e o token:
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu-token-de-autenticacao-turso

# 7. Banco de Dados Neon (PostgreSQL Serverless)
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# 8. Autenticação JWT Benavera
JWT_SECRET=seu-jwt-secret-de-producao-muito-seguro
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 9. Credenciamento de Clínicas
# JWT secret separado para sessões de clínicas no wizard (recomendado diferente do JWT_SECRET)
CLINIC_SESSION_SECRET=seu-clinic-session-secret-producao-muito-seguro

# Storage para documentos de credenciamento
# LOCAL (dev): deixar vazio — usa disco local em uploads/credenciamento/
# PRODUÇÃO: configurar S3/R2 abaixo
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=uploads/credenciamento

# AWS S3 ou Cloudflare R2 (produção)
# STORAGE_ADAPTER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=sua-access-key
# AWS_SECRET_ACCESS_KEY=seu-secret
# AWS_S3_BUCKET=benavera-credenciamentos

# E-mail de envio via Resend (para OTP, convites, alertas)
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL=nao-responda@benavera.com.br

# 10. Integração Parcelex (Hub de Financeiras)
PARCELEX_API_KEY=sua-api-key-parcelex
PARCELEX_BASE_URL=https://url-base-da-api-parcelex
PARCELEX_WEBHOOK_TOKEN=token-secreto-webhook-parcelex
PARCELEX_TIMEOUT_MS=12000

# 11. Integração Konsiga / KonsigaPay (Hub de Financeiras)
# Homologação:
#   KONSIGA_BASE_URL=https://integracao-api-hml.konsiga.com.br/v1
#   KONSIGA_AUTH_URL=https://sso-homolog.b2esistemas.com.br/api/access_token
# Produção:
#   KONSIGA_BASE_URL=https://integracao-api.konsigapay.com.br/v1
#   KONSIGA_AUTH_URL=https://auth-2.b2egroup.com.br/api/access_token
KONSIGA_USERNAME=seu-usuario-konsiga
KONSIGA_PASSWORD=sua-senha-konsiga
KONSIGA_BASE_URL=https://integracao-api.konsigapay.com.br/v1
KONSIGA_AUTH_URL=https://auth-2.b2egroup.com.br/api/access_token
# Opcional — informar apenas quando a operação usar CNPJ consolidador cadastrado na Konsiga
KONSIGA_CNPJ_CONSOLIDADOR=
KONSIGA_WEBHOOK_USERNAME=usuario-basic-auth-webhook
KONSIGA_WEBHOOK_PASSWORD=senha-basic-auth-webhook
KONSIGA_TIMEOUT_MS=15000

# 12. Mensalidades SaaS via Mercado Pago (apenas servidor — NUNCA usar NEXT_PUBLIC_)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-mercado-pago
MERCADOPAGO_WEBHOOK_SECRET=sua-chave-secreta-webhook-mercado-pago
CRON_SECRET=seu-segredo-cron-vercel

# Optional GA4 web stream ID. Internal acquisition analytics works without this.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=ybp8ugw8gf
# Optional Bing verification supplied by the account owner.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
