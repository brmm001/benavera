# ==============================================================================
# BENAVERA — Variáveis de Ambiente de Produção & Desenvolvimento
# ==============================================================================

# 1. URL Canônica Principal do Site (sempre com www)
NEXT_PUBLIC_SITE_URL=https://www.benavera.com.br

# 2. Endpoint de Submissão de Leads
NEXT_PUBLIC_BENAVERA_LEAD_ENDPOINT=/api/leads

# 3. Google Search Console (Código de Verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 4. Microsoft Clarity (Analytics e Gravação de Sessões com Mascaramento)
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=
NEXT_PUBLIC_CLARITY_DEV=false

# 5. Segurança do Painel Administrativo (/admin)
ADMIN_PASSWORD=sua-senha-admin-segura-aqui
ADMIN_SECRET=seu-segredo-de-sessao-aqui

# 6. Banco de Dados Gerenciado — TURSO (libSQL / SQLite na Nuvem) [RECOMENDADO]
# Crie seu banco no Turso (turso db create benavera-db) e insira a URL e o token:
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu-token-de-autenticacao-turso

# 7. (Opcional) Banco de Dados Alternativo (PostgreSQL / Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
